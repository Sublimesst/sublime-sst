# ═══════════════════════════════════════════════════════════
# SUBLIME SST — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local com credenciais reais
# ═══════════════════════════════════════════════════════════

# ── BANCO DE DADOS ──────────────────────────────────────────
# Supabase (recomendado para Vercel) ou PostgreSQL local
DATABASE_URL="postgresql://postgres:password@localhost:5432/sublime_sst"

# ── AUTENTICAÇÃO ADMIN ──────────────────────────────────────
# Senha simples para acesso ao /admin no MVP
ADMIN_SECRET="troque-por-senha-forte-aqui"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── ASAAS (Pagamentos) ──────────────────────────────────────
# Obtenha em: https://www.asaas.com/apiKeys
# Ambiente sandbox: $aact_...  | Produção: $aast_...
ASAAS_API_KEY="$aact_SuaChaveAquiEmSandbox"
ASAAS_ENV="sandbox"              # sandbox | production
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_SECRET="seu_webhook_secret_aqui"

# Valores de cobrança (em centavos)
ASAAS_IMPLANTACAO_PADRAO=19000   # R$ 190,00
ASAAS_IMPLANTACAO_PROMO=10000    # R$ 100,00
ASAAS_PROMO_WINDOW_HOURS=24

# ── GOOGLE SHEETS (Exportação) ──────────────────────────────
# Crie uma Service Account no Google Cloud Console
# Conceda acesso Editor à planilha para o e-mail da service account
GOOGLE_SHEETS_SPREADSHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"sublime-sst@projeto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# ── ANALYTICS ───────────────────────────────────────────────
# Google Analytics 4
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"

# ── EMAIL (SMTP) ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="contato@sublimesst.com"
SMTP_PASS="sua_senha_de_app_gmail"
EMAIL_FROM="Sublime SST <contato@sublimesst.com>"
EMAIL_NOTIFY="contato@sublimesst.com"

# ── CONFIGURAÇÕES DO APP ─────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_WA_NUMBER="5521997248630"
NEXT_PUBLIC_WA_LINK="https://wa.me/5521997248630"
NEXT_PUBLIC_EMAIL="contato@sublimesst.com"
NODE_ENV="development"

# ── RATE LIMITING ────────────────────────────────────────────
# Máximo de submissões por IP por hora
RATE_LIMIT_ELIGIBILITY=10
RATE_LIMIT_LEADS=5
