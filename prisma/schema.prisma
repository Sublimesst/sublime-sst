// ═══════════════════════════════════════════════════════════
// SUBLIME SST — Schema do Banco de Dados
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PLANOS ──────────────────────────────────────────────────
model Plan {
  id           String   @id @default(cuid())
  name         String // "1-5" | "6-10" | "11-20"
  label        String // "1 a 5 funcionários"
  monthlyPrice Int // em centavos
  maxEmployees Int
  minEmployees Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

// ── CATÁLOGO CNAE ────────────────────────────────────────────
model CnaeCatalog {
  id                  String    @id @default(cuid())
  code                String    @unique // "69.20-6"
  description         String
  grauRiscoNr4        Int       @default(1)
  sourcePagePdf       Int?
  onlineCatalogStatus String    @default("pending") // approved | pending | blocked
  eligivelOnline      Boolean   @default(false)
  notes               String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companies Company[]

  @@map("cnae_catalog")
}

// ── LEADS ────────────────────────────────────────────────────
model Lead {
  id          String   @id @default(cuid())
  cnpj        String
  companyName String
  name        String
  email       String
  whatsapp    String
  source      String   @default("site") // site | partner | campaign | organic | whatsapp
  campaign    String?
  partnerId   String?
  status      String   @default("captured") // captured | assessed | eligible | backoffice | registered | converted
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner                Partner?                @relation(fields: [partnerId], references: [id])
  eligibilityAssessments EligibilityAssessment[]
  company                Company?
  contactRequests        ContactRequest[]

  @@index([partnerId])
  @@index([email])
  @@map("leads")
}

// ── AVALIAÇÕES DE ELEGIBILIDADE ──────────────────────────────
model EligibilityAssessment {
  id              String    @id @default(cuid())
  leadId          String
  cnae            String
  cnaeCode        String
  employees       String // "1-5" | "6-10" | "11-20" | "21+"
  usesMachines    Boolean
  usesChemicals   Boolean
  worksAtHeight   Boolean
  hasExternalWork Boolean
  declaration     Boolean
  eligible        Boolean
  reasons         String[]
  resultShownAt   DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("eligibility_assessments")
}

// ── EMPRESAS ─────────────────────────────────────────────────
model Company {
  id               String    @id @default(cuid())
  leadId           String    @unique
  planId           String?
  cnaeId           String?
  cnpj             String    @unique
  razaoSocial      String
  nomeFantasia     String?
  responsavel      String
  email            String
  whatsapp         String
  cep              String
  cidade           String
  estado           String
  endereco         String
  numFuncionarios  Int
  cargos           String?
  observations     String?
  partnerId        String?
  source           String    @default("site")
  implantacaoValor Int       @default(19900)
  implantacaoPromo Boolean   @default(false)
  promoDeadline    DateTime?
  // Snapshot do valor "normal" (sem promoção, sem LTCAT) da implantação no
  // momento do cadastro (Eixo B) — congelado uma única vez, NUNCA relido de
  // pricing.ts depois. implantacaoValor acima já é o valor EFETIVAMENTE
  // contratado (com promo/LTCAT aplicados); este campo existe só para o
  // quadro-resumo poder mostrar os dois lado a lado sem recalcular o valor
  // normal a partir do pricing.ts vigente no momento da geração do PDF.
  // Nullable: Companies criadas antes deste campo não têm esse dado
  // histórico confiável — nesse caso a montagem do quadro-resumo falha
  // explicitamente (ver src/lib/contract/quadroResumo.ts) em vez de
  // inventar o valor a partir do pricing.ts atual.
  implantacaoValorPadrao Int?
  // Snapshot da mensalidade contratada (centavos) — congelado no cadastro,
  // NUNCA relido de pricing.ts depois. Reprecificar pricing.ts só afeta
  // contratações novas; clientes existentes mantêm este valor para sempre.
  // Sem default de propósito: todo cadastro precisa gravar o valor real.
  mensalidadeValor Int

  // Plano e contrato
  planType             String? // "essencial" | "premium"
  ltcatAddon           Boolean   @default(false) // add-on LTCAT contratado (R$ 450)
  contractAcceptedAt   DateTime?
  contractAcceptanceIp String?
  contractAcceptanceUa String?
  contractVersion      String?
  contractHash         String? // SHA-256 do PDF do contrato (prova imutável)

  // Pipeline de implantação
  // pending | onboarding_pending | in_production | in_review | documents_delivered | active | overdue | suspended | migrating | cancelled
  status               String    @default("pending")
  reviewedBy           String? // técnico responsável pela revisão antes de liberar documentos
  reviewedAt           DateTime?
  documentsDeliveredAt DateTime? // preparação P1: setado quando status vira documents_delivered pela 1ª vez

  // Assinatura recorrente Asaas (E4)
  asaasCustomerId     String?
  asaasSubscriptionId String? @unique
  subscriptionStatus  String? // active | overdue | inactive — null = assinatura nunca criada

  // Marco imutável da ativação contratual (Contrato §1-2, docs/DECISIONS.md):
  // instante em que implantação e primeira mensalidade ficam confirmadas
  // simultaneamente pela primeira vez
  // (deriveFinancialActivationState(...).financiallyComplete == true),
  // gravado uma única vez pelo webhook Asaas. NUNCA sobrescrito depois —
  // ativação já ocorrida é fato histórico, mesmo que um pagamento futuro
  // seja estornado/disputado. Nullable: nunca recebe data inventada para
  // Company legada; a ausência é o sinal fail-closed para qualquer cálculo
  // de vigência de 12 meses (ver src/lib/cancellationSchedule.ts).
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead                 Lead                  @relation(fields: [leadId], references: [id])
  plan                 Plan?                 @relation(fields: [planId], references: [id])
  cnae                 CnaeCatalog?          @relation(fields: [cnaeId], references: [id])
  partner              Partner?              @relation(fields: [partnerId], references: [id])
  payments             Payment[]
  clientSessions       ClientSession[]
  onboardingData       OnboardingData?
  checklist            ImplantacaoChecklist?
  esocialLogs          EsocialLog[]
  documentAccessLogs   DocumentAccessLog[]
  commissions          Commission[]
  documents            Document[]
  cancellationRequests CancellationRequest[]
  workers              Worker[]

  @@map("companies")
}

// ── CHECKLIST DE IMPLANTAÇÃO ─────────────────────────────────
model ImplantacaoChecklist {
  id        String @id @default(cuid())
  companyId String @unique

  // PGR + LPP
  pgrStatus       String    @default("pending") // pending | in_progress | done
  pgrConcluidoEm  DateTime?
  pgrConcluidoPor String?

  // PCMSO
  pcmsoStatus       String    @default("pending")
  pcmsoMedico       String?
  pcmsoConcluidoEm  DateTime?
  pcmsoConcluidoPor String?

  // Declaração técnica
  declaracaoStatus       String    @default("pending")
  declaracaoConcluidaEm  DateTime?
  declaracaoConcluidaPor String?

  // Ordens de Serviço + Fichas de EPI
  osEpiStatus       String    @default("pending")
  osEpiConcluidoEm  DateTime?
  osEpiConcluidoPor String?

  // LTCAT (apenas quando ltcatAddon = true)
  ltcatStatus       String? // null = não aplicável
  ltcatConcluidoEm  DateTime?
  ltcatConcluidoPor String?

  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("implantacao_checklist")
}

// ── LOG ESOCIAL ──────────────────────────────────────────────
model EsocialLog {
  id        String @id @default(cuid())
  companyId String

  tipoEvento   String // S-2210 | S-2220 | S-2240
  protocolo    String? // protocolo do eSocial
  status       String    @default("pending") // pending | enviado | confirmado | erro
  descricao    String?
  enviadoEm    DateTime?
  confirmadoEm DateTime?
  observacoes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("esocial_logs")
}

// ── LOG DE ACESSO A DOCUMENTOS (auditoria LGPD) ───────────────
model DocumentAccessLog {
  id        String  @id @default(cuid())
  companyId String
  sessionId String?

  tipoDocumento String // pgr | pcmso | declaracao | os_epi | ltcat | contrato
  nomeDocumento String?
  acao          String   @default("download") // view | download
  ip            String?
  userAgent     String?
  accessedAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, accessedAt])
  @@map("document_access_logs")
}

// ── DOCUMENTOS ENTREGUES (PGR, PCMSO, etc.) ───────────────────
// Document não sabe COMO os bytes são guardados — só referencia
// storageProvider + storageKey (ver src/lib/storage). Trocar de
// provider no futuro não exige mudar este model.
model Document {
  id              String   @id @default(cuid())
  companyId       String
  tipoDocumento   String // pgr | pcmso | declaracao | os_epi | ltcat | contrato
  nomeArquivo     String
  mimeType        String
  tamanhoBytes    Int
  storageProvider String // "db" (interino, ver src/lib/storage/dbProvider.ts)
  storageKey      String   @unique
  uploadedBy      String?
  uploadedAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("documents")
}

// ── OBJETOS DE ARMAZENAMENTO (provider interino "db") ─────────
// "Bucket" dentro do Postgres, usado só pelo DbStorageProvider.
// Fica isolado do model Document de propósito: quando o provider
// definitivo (Supabase Storage) entrar, esta tabela para de ser
// usada e nada no Document precisa mudar.
model DbStorageObject {
  key         String   @id
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())

  @@map("storage_objects_db")
}

// ── CANCELAMENTO (regra de vigência de 12 meses — docs/DECISIONS.md,
// docs/CONTRACT_MVP_V1.md §3) ───────────────────────────────────
// Trilha do pedido de cancelamento. feeCents/pendingCents continuam sendo
// preenchidos manualmente pelo admin para casos excepcionais (ex.: débitos
// já vencidos) — a regra nova NÃO gera multa/rescisão antecipada automática
// para um aviso de não renovação (as parcelas restantes já cobrem isso).
model CancellationRequest {
  id           String   @id @default(cuid())
  companyId    String
  requestedAt  DateTime
  reason       String
  requestedBy  String
  handledBy    String?
  feeCents     Int?
  pendingCents Int?
  notes        String?
  createdAt    DateTime @default(now())

  // Distingue o fluxo que originou o pedido:
  //   pre_activation_withdrawal — Company.activatedAt ainda null e
  //     financeiramente incompleta: desistência antes da ativação (Contrato
  //     §2), processada imediatamente (mesma semântica fail-closed da
  //     PR #23: Asaas cancelada antes da transição local).
  //   non_renewal_notice — Company já ativada: aviso de não renovação, só
  //     produz efeito em effectiveAt, sem interromper cobrança/acesso antes
  //     disso (Contrato §3).
  // null = pedido criado antes desta migração (o único registro real já
  // existente em Produção) — nunca reclassificado retroativamente.
  kind String?

  // Snapshot imutável de Company.activatedAt no instante em que effectiveAt
  // foi calculado — nunca relido depois. null para pre_activation_withdrawal
  // (não há ativação) e para pedidos legados.
  activatedAtSnapshot DateTime?

  // Data em que o encerramento produz efeito — calculada uma única vez no
  // momento do pedido (ver src/lib/cancellationSchedule.ts) e nunca
  // recalculada depois, mesmo que a regra de cálculo mude no futuro. Para
  // pre_activation_withdrawal, igual a requestedAt (processamento
  // imediato). null só para pedidos legados anteriores a esta migração.
  effectiveAt DateTime?

  // pending (aguardando effectiveAt) | processed (encerramento já aplicado
  // — inclui pre_activation_withdrawal, sempre concluído na própria
  // requisição). Default "processed" reflete um fato estrutural: todo
  // pedido criado antes desta migração só podia ser imediato, logo já
  // nasceu processado — não é um valor inventado.
  status String @default("processed")

  processedAt DateTime?

  // Último erro ao tentar aplicar o encerramento efetivo (ex.: falha da
  // Asaas) — só para diagnóstico/retry manual; nunca payload sensível.
  lastProcessingError String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status, effectiveAt])
  @@map("cancellation_requests")
}

// ── PARCEIROS ────────────────────────────────────────────────
model Partner {
  id              String  @id @default(cuid())
  code            String  @unique @default(cuid())
  name            String
  office          String
  cnpj            String?
  email           String
  whatsapp        String
  city            String?
  state           String?
  clientsEstimate Int?
  tier            String  @default("comum") // comum | recorrente | estratégico
  status          String  @default("pending") // pending | active | inactive
  notes           String?

  // Aceite eletrônico do Termo de Parceria
  termsAcceptedAt   DateTime?
  termsAcceptanceIp String?
  termsVersion      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leads       Lead[]
  referrals   PartnerReferral[]
  companies   Company[]
  sessions    PartnerSession[]
  commissions Commission[]

  @@map("partners")
}

// ── SESSÕES DE PARCEIRO (magic link auth) ────────────────────
model PartnerSession {
  id        String    @id @default(cuid())
  partnerId String
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@map("partner_sessions")
}

// ── INDICAÇÕES DE PARCEIROS ──────────────────────────────────
model PartnerReferral {
  id           String    @id @default(cuid())
  partnerId    String
  companyName  String
  cnpj         String?
  contactName  String?
  phone        String?
  email        String?
  employeesEst Int?
  observations String?
  status       String    @default("pending") // pending | contacted | converted | lost
  convertedAt  DateTime?
  rewardAmount Int?
  rewardPaidAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id])

  @@map("partner_referrals")
}

// ── COMISSÕES DE PARCEIROS ───────────────────────────────────
model Commission {
  id        String  @id @default(cuid())
  partnerId String
  companyId String
  paymentId String?

  mensalidadeNum Int // 1 a 12
  mensalidadeLiq Int // centavos (líquido após impostos/taxas)
  percentual     Int @default(10)
  valorComissao  Int // centavos

  // em_carencia (30 dias) | liberada | paga | estornada
  status     String    @default("em_carencia")
  liberadaEm DateTime?
  pagaEm     DateTime?

  referencia  String? // ex: "2026-08" (ano-mês da mensalidade)
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner  @relation(fields: [partnerId], references: [id])
  company Company  @relation(fields: [companyId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([partnerId])
  @@index([paymentId])
  @@map("commissions")
}

// ── PAGAMENTOS ───────────────────────────────────────────────
model Payment {
  id                String    @id @default(cuid())
  companyId         String
  asaasId           String?   @unique
  externalReference String? // ecoado pela Asaas (= companyId, propagado da assinatura) — usado p/ reconciliar mensalidade desconhecida
  type              String // implantacao | mensalidade
  amount            Int // centavos
  status            String    @default("pending") // pending | confirmed | failed | refunded
  dueDate           DateTime?
  paidAt            DateTime?
  checkoutUrl       String?
  invoiceUrl        String?
  billingType       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  commissions Commission[]

  @@index([companyId, type, status])
  @@map("payments")
}

// ── SESSÕES DE CLIENTE (magic link auth) ─────────────────────
model ClientSession {
  id        String    @id @default(cuid())
  companyId String
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@map("client_sessions")
}

// ── DADOS DE ONBOARDING ──────────────────────────────────────
model OnboardingData {
  id        String @id @default(cuid())
  companyId String @unique

  // em_preenchimento | enviado — default "enviado" é proposital: preserva a
  // semântica histórica dos registros já existentes, todos criados só no
  // momento do envio final pelo código anterior a esta tranche. Fluxos novos
  // de rascunho sempre definem "em_preenchimento" explicitamente na escrita.
  status String @default("enviado")

  // Snapshot da quantidade de trabalhadores efetivamente declarada no envio
  // (= count(Worker) no instante do envio, congelado — nunca recalculado
  // depois). Nullable porque, durante o rascunho, ainda não há snapshot;
  // deixou de ser digitado pelo cliente.
  numFuncionarios Int?
  cargos          String?
  turnoTrabalho   String?
  observacoes     String?
  dataUltimoPcmso String?
  // null = ainda não respondido (rascunho); true/false só após resposta
  // explícita do cliente — obrigatório no envio.
  possuiPgr       Boolean?
  submittedAt     DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@map("onboarding_data")
}

// ── TRABALHADORES INDIVIDUAIS DO ONBOARDING ───────────────────
// Um registro por trabalhador declarado pelo cliente durante o onboarding
// individual. Ligado diretamente à Company (não a OnboardingData) para não
// depender de OnboardingData já existir ao salvar o 1º rascunho de Worker.
// Campos nullable durante o rascunho; obrigatoriedade de envio é validada
// só na aplicação (mesmo padrão já usado em OnboardingData).
model Worker {
  id        String @id @default(cuid())
  companyId String

  nome           String?
  dataNascimento DateTime? @db.Date
  sexo           String? // "M" | "F"
  dataAdmissao   DateTime? @db.Date
  cargo          String?
  setor          String? // opcional mesmo no envio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("workers")
}

// ── SOLICITAÇÕES DE CONTATO ───────────────────────────────────
model ContactRequest {
  id        String   @id @default(cuid())
  leadId    String?
  name      String
  email     String
  whatsapp  String?
  message   String?
  origin    String   @default("site") // site | backoffice | whatsapp
  status    String   @default("open") // open | in_progress | resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id])

  @@map("contact_requests")
}
